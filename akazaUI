		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local head = character:FindFirstChild("Head")
	if not humanoid or humanoid.Health <= 0 or not head then
		HL.target = nil
		return
	end
	local currentCFrame = Camera.CFrame
	local targetCFrame = CFrame.lookAt(currentCFrame.Position, head.Position)
	Camera.CFrame = currentCFrame:Lerp(targetCFrame, HL.smoothness)
end)

RunService.Heartbeat:Connect(function()
	if PA.unloaded then return end
	if not PA.enabled then
		pa_clearAssist()
		return
	end
	local now = tick()
	if now - PA.lastCheck < PA.checkInterval then return end
	PA.lastCheck = now
	local root = pa_getRoot()
	if not root then
		pa_clearAssist()
		return
	end
	local platform = pa_findPlatformBelow(root)
	if platform then
		if not PA.align or PA.align.Parent ~= root then
			pa_createAlign(root, platform)
		end
	else
		pa_clearAssist()
	end
end)

