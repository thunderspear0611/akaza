UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.Q then
		local newVal = not AG.enabled
		if Toggles.AutoGrabEnabled then
			Toggles.AutoGrabEnabled:SetValue(newVal)
		else
			ag_setEnabled(newVal)
		end
	elseif input.KeyCode == Enum.KeyCode.C then
		local newVal = not HL.enabled
		if Toggles.HeadLockEnabled then
			Toggles.HeadLockEnabled:SetValue(newVal)
		else
			hl_setEnabled(newVal)
		end
	elseif input.KeyCode == Enum.KeyCode.V then
		local newVal = not PA.enabled
		if Toggles.PalletEnabled then
			Toggles.PalletEnabled:SetValue(newVal)
		else
			pa_setEnabled(newVal)
		end
	end
end)

