RunService.RenderStepped:Connect(function()
	-- AutoGrab
	if not AG.enabled then
		if AG.isHolding then
			ag_release()
			AG.isHolding = false
		end
	else
		local currentlyHoldingChar = ag_isHoldingCharacter()
		if AG.wasHoldingCharacter and not currentlyHoldingChar then
			AG.lastReleaseTime = tick()
		end
		AG.wasHoldingCharacter = currentlyHoldingChar

		if tick() - AG.lastReleaseTime >= AG.releaseCooldown then
			if not ag_isLocalPlayerHolding() then
				local char = LocalPlayer.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if root then
					local myPos = root.Position
					local found = false

					for _, plr in ipairs(Players:GetPlayers()) do
						if plr ~= LocalPlayer then
							local otherChar = plr.Character
							if otherChar then
								local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")
								if otherRoot and (myPos - otherRoot.Position).Magnitude <= AG.maxDistance then
									if not ag_isAlreadyGrabbed(otherChar) then
										for _, part in ipairs(ag_getAllParts(otherChar)) do
											if ag_isCentered(part.Position) then
												found = true
												break
											end
										end
									end
								end
							end
						end
						if found then break end
					end

					if not found then
						for _, obj in ipairs(workspace:GetChildren()) do
							if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
								local hrp = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
								if hrp and (myPos - hrp.Position).Magnitude <= AG.maxDistance then
									if not ag_isAlreadyGrabbed(obj) then
										for _, part in ipairs(ag_getAllParts(obj)) do
											if ag_isCentered(part.Position) then
												found = true
												break
											end
										end
									end
								end
							end
							if found then break end
						end
					end

					if found then
						if not AG.isHolding then
							ag_press()
							AG.isHolding = true
						end
					else
						if AG.isHolding then
							ag_release()
							AG.isHolding = false
						end
					end
				end
			end
		end
	end
end)

