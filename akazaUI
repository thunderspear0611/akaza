local function applyPreset(name)
	local p = Presets[name]
	if not p then return end
	WV.currentPreset = name
	clearOldEffects()

	Lighting.Ambient = p.Ambient
	Lighting.OutdoorAmbient = p.OutdoorAmbient
	Lighting.Brightness = p.Brightness
	Lighting.ClockTime = p.ClockTime
	Lighting.FogColor = p.FogColor
	Lighting.FogStart = p.FogStart
	Lighting.FogEnd = p.FogEnd
	Lighting.ColorShift_Top = p.ColorShift_Top
	Lighting.ColorShift_Bottom = p.ColorShift_Bottom
	Lighting.EnvironmentDiffuseScale = p.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = p.EnvironmentSpecularScale
	Lighting.ExposureCompensation = p.ExposureCompensation
	Lighting.GlobalShadows = p.GlobalShadows
	pcall(function() Lighting.ShadowSoftness = p.ShadowSoftness or 0.5 end)

	if p.Bloom then
		makeEffect("BloomEffect", {
			Intensity = p.Bloom.Intensity,
			Size = p.Bloom.Size,
			Threshold = p.Bloom.Threshold,
		})
	end
	if p.ColorCorrection then
		makeEffect("ColorCorrectionEffect", {
			Brightness = p.ColorCorrection.Brightness,
			Contrast = p.ColorCorrection.Contrast,
			Saturation = p.ColorCorrection.Saturation,
			TintColor = p.ColorCorrection.TintColor,
		})
	end
	if p.SunRays then
		makeEffect("SunRaysEffect", {
			Intensity = p.SunRays.Intensity,
			Spread = p.SunRays.Spread,
		})
	end
	if p.Atmosphere then
		makeEffect("Atmosphere", {
			Density = p.Atmosphere.Density,
			Offset = p.Atmosphere.Offset,
			Color = p.Atmosphere.Color,
			Decay = p.Atmosphere.Decay,
			Glare = p.Atmosphere.Glare,
			Haze = p.Atmosphere.Haze,
		})
	end
	if p.skyFn then
		p.skyFn()
	end
end

local function restoreOriginal()
	clearOldEffects()
	for k, v in pairs(Original) do
		pcall(function() Lighting[k] = v end)
	end
	if OriginalSky then
		local s = OriginalSky:Clone()
		s.Parent = Lighting
	end
	WV.enabled = false
end

local function wv_setEnabled(value)
	WV.enabled = value
