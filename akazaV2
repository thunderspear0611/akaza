local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

local maxDistance = 29
local fov = 0.015
local releaseCooldown = 1.0
local pressHoldTime = 0.05
local releaseGapTime = 0.07
local minPressFrames = 3

local enabled = false
local isHolding = false
local lastReleaseTime = 0
local wasHoldingCharacter = false

local clickPhase = "idle"
local clickPhaseStart = 0
local pressFrameCount = 0

local fovSq = fov * fov

-- キャッシュ
local npcCache = {}
local npcNextRefresh = 0
local npcRefreshInterval = 0.3

-- GrabParts参照キャッシュ
local grabPartsRef = nil
local grabPartsNextCheck = 0

local function press()
    pcall(function()
        if mouse1press then mouse1press() end
    end)
end

local function release()
    pcall(function()
        if mouse1release then mouse1release() end
    end)
end

local function isCentered(pos)
    local screen, onScreen = Camera:WorldToViewportPoint(pos)
    if not onScreen or screen.Z <= 0 then return false end
    local size = Camera.ViewportSize
    local dx = (screen.X - size.X * 0.5) / size.X
    local dy = (screen.Y - size.Y * 0.5) / size.Y
    return (dx * dx + dy * dy) <= fovSq
end

-- GrabParts参照を0.1秒ごとに更新 (FindFirstChild呼び出し削減)
local function getGrabParts()
    local now = tick()
    if now >= grabPartsNextCheck or (grabPartsRef and not grabPartsRef.Parent) then
        grabPartsRef = workspace:FindFirstChild("GrabParts")
        grabPartsNextCheck = now + 0.1
    end
    return grabPartsRef
end

local function getGrabbedPart()
    local grabParts = getGrabParts()
    if not grabParts then return nil end
    local grabPart = grabParts:FindFirstChild("GrabPart")
    if not grabPart then return nil end
    local weld = grabPart:FindFirstChild("WeldConstraint")
    if not weld then return nil end
    return weld.Part1
end

local function isLocalPlayerHolding()
    return getGrabbedPart() ~= nil
end

local function isHoldingCharacter()
    local part = getGrabbedPart()
    if not part then return false end

    local model = part:FindFirstAncestorOfClass("Model")
    if not model then return false end

    if Players:GetPlayerFromCharacter(model) then
        return true
    end
    if model:FindFirstChildOfClass("Humanoid") then
        return true
    end
    return false
end

-- 軽量BasePart収集 (GetChildren再帰)
local function collectBaseParts(root, list)
    for _, c in ipairs(root:GetChildren()) do
        if c:IsA("BasePart") then
            list[#list + 1] = c
        elseif c:IsA("Model") or c:IsA("Folder") or c:IsA("Accessory") then
            collectBaseParts(c, list)
        end
    end
    return list
end

-- NPCキャッシュ更新
local function refreshNpcCache()
    npcCache = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hum and not Players:GetPlayerFromCharacter(obj) then
                local anchor = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                if anchor then
                    npcCache[#npcCache + 1] = {
                        model = obj,
                        anchor = anchor,
                        parts = collectBaseParts(obj, {}),
                    }
                end
            end
        end
    end
end

local function findTarget()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local myPos = root.Position

    -- プレイヤー
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local otherChar = plr.Character
            if otherChar then
                local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")
                if otherRoot and (myPos - otherRoot.Position).Magnitude <= maxDistance then
                    local parts = collectBaseParts(otherChar, {})
                    for i = 1, #parts do
                        local part = parts[i]
                        if part.Parent and isCentered(part.Position) then
                            return true
                        end
                    end
                end
            end
        end
    end

    -- NPC (キャッシュ使用)
    for i = 1, #npcCache do
        local entry = npcCache[i]
        local anchor = entry.anchor
        if anchor.Parent then
            if (myPos - anchor.Position).Magnitude <= maxDistance then
                local parts = entry.parts
                for j = 1, #parts do
                    local part = parts[j]
                    if part.Parent and isCentered(part.Position) then
                        return true
                    end
                end
            end
        end
    end

    return false
end

local function tickClickState(targetPresent)
    local now = tick()

    if clickPhase == "idle" then
        if targetPresent then
            press()
            clickPhase = "pressing"
            clickPhaseStart = now
            pressFrameCount = 0
        end
    elseif clickPhase == "pressing" then
        pressFrameCount = pressFrameCount + 1
        if now - clickPhaseStart >= pressHoldTime and pressFrameCount >= minPressFrames then
            release()
            clickPhase = "releasing"
            clickPhaseStart = now
        end
    elseif clickPhase == "releasing" then
        if now - clickPhaseStart >= releaseGapTime then
            if targetPresent then
                press()
                clickPhase = "pressing"
                clickPhaseStart = now
                pressFrameCount = 0
            else
                clickPhase = "idle"
            end
        end
    end
end

local function resetClickState()
    if clickPhase == "pressing" then
        release()
    end
    clickPhase = "idle"
    clickPhaseStart = 0
    pressFrameCount = 0
end

RunService.Heartbeat:Connect(function()
    if not enabled then
        if isHolding then
            release()
            isHolding = false
        end
        resetClickState()
        return
    end

    local now = tick()

    if now >= npcNextRefresh then
        npcNextRefresh = now + npcRefreshInterval
        refreshNpcCache()
    end

    local currentlyHoldingChar = isHoldingCharacter()

    if wasHoldingCharacter and not currentlyHoldingChar then
        lastReleaseTime = now
    end
    wasHoldingCharacter = currentlyHoldingChar

    if now - lastReleaseTime < releaseCooldown then
        resetClickState()
        return
    end

    if isLocalPlayerHolding() then
        resetClickState()
        return
    end

    local found = findTarget()
    tickClickState(found)
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.Q then
        enabled = not enabled
        if not enabled and isHolding then
            release()
            isHolding = false
        end
        resetClickState()
        print(enabled and "[AutoGrab] ON" or "[AutoGrab] OFF")
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    if isHolding then
        release()
        isHolding = false
    end
    resetClickState()
end)

print("[FTAP AutoGrab v20] Loaded - Press Q")





local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local enabled = false
local target = nil

-- 数値を大きくすると速く追従
local smoothness = 0.15

-- 自分に一番近いプレイヤーを探す（3D距離）
local function getClosestPlayer()
	local closestPlayer = nil
	local closestDistance = math.huge

	local myCharacter = player.Character
	if not myCharacter then
		return nil
	end

	local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
		or myCharacter:FindFirstChild("Torso")
		or myCharacter:FindFirstChild("UpperTorso")
	if not myRoot then
		return nil
	end

	local myPos = myRoot.Position

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player then
			local character = otherPlayer.Character
			if character then
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				local head = character:FindFirstChild("Head")
				local root = character:FindFirstChild("HumanoidRootPart")
					or character:FindFirstChild("Torso")
					or character:FindFirstChild("UpperTorso")

				if humanoid and head and root and humanoid.Health > 0 then
					local distance = (root.Position - myPos).Magnitude
					if distance < closestDistance then
						closestDistance = distance
						closestPlayer = otherPlayer
					end
				end
			end
		end
	end

	return closestPlayer
end

-- CキーでON/OFF
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if input.KeyCode == Enum.KeyCode.C then
		enabled = not enabled
		if enabled then
			target = getClosestPlayer()
		else
			target = nil
		end
	end
end)

-- カメラを頭へ向ける
RunService:BindToRenderStep(
	"HeadLockOn",
	Enum.RenderPriority.Camera.Value + 1,
	function()
		if not enabled then
			return
		end

		-- 毎フレーム最寄りを更新（動いても追従）
		target = getClosestPlayer()

		if not target then
			return
		end

		local character = target.Character
		if not character then
			target = nil
			return
		end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local head = character:FindFirstChild("Head")

		if not humanoid or humanoid.Health <= 0 or not head then
			target = nil
			return
		end

		local currentCFrame = camera.CFrame
		local targetCFrame = CFrame.lookAt(
			currentCFrame.Position,
			head.Position
		)

		camera.CFrame = currentCFrame:Lerp(
			targetCFrame,
			smoothness
		)
	end
)





-- FTAP Pallet Assist v2
-- Toggle: V
-- Unload: P (completely removes the script)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

------------------------
-- SETTINGS
------------------------
local maxStickDistance = 6
local checkInterval = 0.03
------------------------

local enabled = false
local connection = nil
local inputConn = nil
local charConn = nil
local align = nil
local lastCheck = 0
local unloaded = false

local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function clearAssist()
    if align then
        pcall(function() align:Destroy() end)
        align = nil
    end
end

local function isPalletLike(part)
    if not part or not part:IsA("BasePart") or part.Anchored then return false end
    local name = part.Name:lower()
    if name:find("pallet") or name:find("board") or name:find("platform") or name:find("wood") or name:find("plank") then
        return true
    end
    local size = part.Size
    return size.Y < 4 and (size.X > 3 or size.Z > 3)
end

local function findPlatformBelow(root)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    local result = workspace:Raycast(root.Position, Vector3.new(0, -maxStickDistance, 0), params)
    if result and isPalletLike(result.Instance) then
        return result.Instance, result.Position
    end
    return nil, nil
end

local function createAlign(root, platform)
    clearAssist()
    local att0 = Instance.new("Attachment")
    att0.Parent = root
    local att1 = Instance.new("Attachment")
    att1.Parent = platform

    local a = Instance.new("AlignPosition")
    a.Attachment0 = att0
    a.Attachment1 = att1
    a.RigidityEnabled = false
    a.MaxForce = 2500
    a.MaxVelocity = 40
    a.Responsiveness = 25
    a.ApplyAtCenterOfMass = true
    a.Parent = root
    align = a

    -- keep a small offset so you stand on top
    att1.Position = Vector3.new(0, platform.Size.Y * 0.5 + 2.5, 0)
end

local function mainLoop()
    if unloaded then return end
    if not enabled then
        clearAssist()
        return
    end

    local now = tick()
    if now - lastCheck < checkInterval then return end
    lastCheck = now

    local root = getRoot()
    if not root then
        clearAssist()
        return
    end

    local platform = findPlatformBelow(root)
    if platform then
        if not align or align.Parent ~= root then
            createAlign(root, platform)
        end
    else
        clearAssist()
    end
end

local function unload()
    if unloaded then return end
    unloaded = true
    enabled = false
    clearAssist()
    if connection then connection:Disconnect() end
    if inputConn then inputConn:Disconnect() end
    if charConn then charConn:Disconnect() end
    print("[Pallet Assist] Fully unloaded")
end

connection = RunService.Heartbeat:Connect(mainLoop)

inputConn = UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or unloaded then return end
    if input.KeyCode == Enum.KeyCode.V then
        enabled = not enabled
        if not enabled then clearAssist() end
        print(enabled and "[Pallet Assist] ON" or "[Pallet Assist] OFF")
    elseif input.KeyCode == Enum.KeyCode.P then
        unload()
    end
end)

charConn = LocalPlayer.CharacterAdded:Connect(function()
    clearAssist()
end)

print("[FTAP Pallet Assist v2] Loaded")
print("V = toggle | P = full unload")
