local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- ===== 設定 =====
local maxDistance    = 29       -- 対象探索の最大距離 (studs)
local fov            = 0.015    -- 画面中心からの許容半径 (viewport比)
local pressHoldTime  = 0.05     -- 押しっぱなしにする時間
local releaseGapTime = 0.07     -- 離してから次に押すまでの間隔
local minPressFrames = 3        -- 最低押下フレーム数 (Heartbeat基準)

local HOLD_RELEASE_COOLDOWN = 0.8   -- 条件2: プレイヤーを離した後 0.8 秒間停止
-- ================

local enabled = false
local isHolding = false
local lastPlayerReleaseTime = -math.huge
local wasHoldingPlayer = false

local clickPhase = "idle"
local clickPhaseStart = 0
local pressFrameCount = 0

local fovSq = fov * fov

local npcCache = {}
local npcNextRefresh = 0
local npcRefreshInterval = 0.3

local grabPartsRef = nil
local grabPartsNextCheck = 0

local function press()
    pcall(function() if mouse1press then mouse1press() end end)
end

local function release()
    pcall(function() if mouse1release then mouse1release() end end)
end

local function isCentered(pos)
    local screen, onScreen = Camera:WorldToViewportPoint(pos)
    if not onScreen or screen.Z <= 0 then return false end
    local size = Camera.ViewportSize
    local dx = (screen.X - size.X * 0.5) / size.X
    local dy = (screen.Y - size.Y * 0.5) / size.Y
    return (dx * dx + dy * dy) <= fovSq
end

local function getGrabParts()
    local now = tick()
    if now >= grabPartsNextCheck or (grabPartsRef and not grabPartsRef.Parent) then
        grabPartsRef = workspace:FindFirstChild("GrabParts")
        grabPartsNextCheck = now + 0.1
    end
    return grabPartsRef
end

local function getGrabbedPart()
    local grabParts = getGrabParts()
    if not grabParts then return nil end
    local grabPart = grabParts:FindFirstChild("GrabPart")
    if not grabPart then return nil end
    local weld = grabPart:FindFirstChild("WeldConstraint")
    if not weld then return nil end
    return weld.Part1
end

local function isLocalPlayerHolding()
    return getGrabbedPart() ~= nil
end

-- 掴んでいる対象が「プレイヤーのキャラクター」かどうか
local function isHoldingPlayerCharacter()
    local part = getGrabbedPart()
    if not part then return false end

    local model = part:FindFirstChildOfClass("Model")
    if not model then
        -- 親をたどってModelを探す (Accessory等の中にいる場合)
        model = part:FindFirstAncestorOfClass("Model")
    end
    if not model then return false end

    if Players:GetPlayerFromCharacter(model) then return true end

    -- プレイヤーキャラでなくてもHumanoid持ちならキャラ扱い
    if model:FindFirstChildOfClass("Humanoid") then return true end

    return false
end

local function collectBaseParts(root, list)
    for _, c in ipairs(root:GetChildren()) do
        if c:IsA("BasePart") then
            list[#list + 1] = c
        elseif c:IsA("Model") or c:IsA("Folder") or c:IsA("Accessory") then
            collectBaseParts(c, list)
        end
    end
    return list
end

local function refreshNpcCache()
    npcCache = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hum and not Players:GetPlayerFromCharacter(obj) then
                local anchor = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                if anchor then
                    npcCache[#npcCache + 1] = {
                        model = obj,
                        anchor = anchor,
                        parts = collectBaseParts(obj, {}),
                    }
                end
            end
        end
    end
end

local function findTarget()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local myPos = root.Position

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local otherChar = plr.Character
            if otherChar then
                local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")
                if otherRoot and (myPos - otherRoot.Position).Magnitude <= maxDistance then
                    local parts = collectBaseParts(otherChar, {})
                    for i = 1, #parts do
                        local part = parts[i]
                        if part.Parent and isCentered(part.Position) then
                            return true
                        end
                    end
                end
            end
        end
    end

    for i = 1, #npcCache do
        local entry = npcCache[i]
        local anchor = entry.anchor
        if anchor.Parent and (myPos - anchor.Position).Magnitude <= maxDistance then
            local parts = entry.parts
            for j = 1, #parts do
                local part = parts[j]
                if part.Parent and isCentered(part.Position) then
                    return true
                end
            end
        end
    end

    return false
end

local function tickClickState(targetPresent)
    local now = tick()

    if clickPhase == "idle" then
        if targetPresent then
            press()
            clickPhase = "pressing"
            clickPhaseStart = now
            pressFrameCount = 0
        end
    elseif clickPhase == "pressing" then
        pressFrameCount = pressFrameCount + 1
        if now - clickPhaseStart >= pressHoldTime and pressFrameCount >= minPressFrames then
            release()
            clickPhase = "releasing"
            clickPhaseStart = now
        end
    elseif clickPhase == "releasing" then
        if now - clickPhaseStart >= releaseGapTime then
            if targetPresent then
                press()
                clickPhase = "pressing"
                clickPhaseStart = now
                pressFrameCount = 0
            else
                clickPhase = "idle"
            end
        end
    end
end

local function resetClickState()
    if clickPhase == "pressing" then
        release()
    end
    clickPhase = "idle"
    clickPhaseStart = 0
    pressFrameCount = 0
end

RunService.Heartbeat:Connect(function()
    if not enabled then
        if isHolding then
            release()
            isHolding = false
        end
        resetClickState()
        return
    end

    local now = tick()

    -- NPCキャッシュ更新
    if now >= npcNextRefresh then
        npcNextRefresh = now + npcRefreshInterval
        refreshNpcCache()
    end

    -- 条件2: プレイヤーを離した検出
    local holdingPlayer = isHoldingPlayerCharacter()
    if wasHoldingPlayer and not holdingPlayer then
        lastPlayerReleaseTime = now
    end
    wasHoldingPlayer = holdingPlayer

    -- 条件1: 何か掴んでいる間は絶対に発動しない
    if isLocalPlayerHolding() then
        resetClickState()
        return
    end

    -- 条件2: プレイヤーを離した後 0.8 秒間は停止
    if now - lastPlayerReleaseTime < HOLD_RELEASE_COOLDOWN then
        resetClickState()
        return
    end

    local found = findTarget()
    tickClickState(found)
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.Q then
        enabled = not enabled
        if not enabled and isHolding then
            release()
            isHolding = false
        end
        resetClickState()
        print(enabled and "[AutoGrab] ON" or "[AutoGrab] OFF")
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    if isHolding then
        release()
        isHolding = false
    end
    wasHoldingPlayer = false
    lastPlayerReleaseTime = -math.huge
    resetClickState()
end)





