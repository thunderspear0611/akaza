-- FTAP AutoGrab v16
-- Toggle: Q
-- 1s cooldown only after releasing a Player or NPC (not normal objects)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

------------------------
-- SETTINGS
------------------------
local maxDistance = 28
local fov = 0.015
local releaseCooldown = 1.0
------------------------

local enabled = false
local isHolding = false
local lastReleaseTime = 0
local wasHoldingCharacter = false

local function press()
    pcall(function()
        if mouse1press then mouse1press() end
    end)
end

local function release()
    pcall(function()
        if mouse1release then mouse1release() end
    end)
end

local function isCentered(pos)
    local screen, onScreen = Camera:WorldToViewportPoint(pos)
    if not onScreen or screen.Z <= 0 then return false end
    local size = Camera.ViewportSize
    local dx = (screen.X - size.X * 0.5) / size.X
    local dy = (screen.Y - size.Y * 0.5) / size.Y
    return (dx * dx + dy * dy) <= (fov * fov)
end

local function getGrabbedPart()
    local grabParts = workspace:FindFirstChild("GrabParts")
    if not grabParts then return nil end
    local grabPart = grabParts:FindFirstChild("GrabPart")
    if not grabPart then return nil end
    local weld = grabPart:FindFirstChild("WeldConstraint")
    if not weld then return nil end
    return weld.Part1
end

local function isLocalPlayerHolding()
    return getGrabbedPart() ~= nil
end

-- true if the currently grabbed thing is a Player or NPC
local function isHoldingCharacter()
    local part = getGrabbedPart()
    if not part then return false end

    local model = part:FindFirstAncestorOfClass("Model")
    if not model then return false end

    -- real player
    if Players:GetPlayerFromCharacter(model) then
        return true
    end
    -- NPC (has Humanoid but not a player)
    if model:FindFirstChildOfClass("Humanoid") then
        return true
    end
    return false
end

local function isAlreadyGrabbed(character)
    local part = getGrabbedPart()
    if not part then return false end
    return part:IsDescendantOf(character)
end

local function getAllParts(character)
    local parts = {}
    for _, p in ipairs(character:GetDescendants()) do
        if p:IsA("BasePart") then
            table.insert(parts, p)
        end
    end
    return parts
end

RunService.RenderStepped:Connect(function()
    if not enabled then
        if isHolding then
            release()
            isHolding = false
        end
        return
    end

    local currentlyHoldingChar = isHoldingCharacter()

    -- just released a player/NPC → start cooldown
    if wasHoldingCharacter and not currentlyHoldingChar then
        lastReleaseTime = tick()
    end
    wasHoldingCharacter = currentlyHoldingChar

    -- still in cooldown
    if tick() - lastReleaseTime < releaseCooldown then
        return
    end

    -- already holding anything → don't start new grab
    if isLocalPlayerHolding() then return end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local myPos = root.Position
    local found = false

    -- Players
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local otherChar = plr.Character
            if otherChar then
                local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")
                if otherRoot and (myPos - otherRoot.Position).Magnitude <= maxDistance then
                    if not isAlreadyGrabbed(otherChar) then
                        for _, part in ipairs(getAllParts(otherChar)) do
                            if isCentered(part.Position) then
                                found = true
                                break
                            end
                        end
                    end
                end
            end
        end
        if found then break end
    end

    -- NPCs (light scan)
    if not found then
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
                local hrp = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                if hrp and (myPos - hrp.Position).Magnitude <= maxDistance then
                    if not isAlreadyGrabbed(obj) then
                        for _, part in ipairs(getAllParts(obj)) do
                            if isCentered(part.Position) then
                                found = true
                                break
                            end
                        end
                    end
                end
            end
            if found then break end
        end
    end

    if found then
        if not isHolding then
            press()
            isHolding = true
        end
    else
        if isHolding then
            release()
            isHolding = false
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.Q then
        enabled = not enabled
        if not enabled and isHolding then
            release()
            isHolding = false
        end
        print(enabled and "[AutoGrab] ON" or "[AutoGrab] OFF")
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    if isHolding then
        release()
        isHolding = false
    end
end)

print("[FTAP AutoGrab v16] Loaded - Press Q")
print("1s cooldown only after releasing Player / NPC")





local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local enabled = false
local target = nil

-- 数値を大きくすると速く追従
local smoothness = 0.2

-- 自分に一番近いプレイヤーを探す（3D距離）
local function getClosestPlayer()
	local closestPlayer = nil
	local closestDistance = math.huge

	local myCharacter = player.Character
	if not myCharacter then
		return nil
	end

	local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
		or myCharacter:FindFirstChild("Torso")
		or myCharacter:FindFirstChild("UpperTorso")
	if not myRoot then
		return nil
	end

	local myPos = myRoot.Position

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player then
			local character = otherPlayer.Character
			if character then
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				local head = character:FindFirstChild("Head")
				local root = character:FindFirstChild("HumanoidRootPart")
					or character:FindFirstChild("Torso")
					or character:FindFirstChild("UpperTorso")

				if humanoid and head and root and humanoid.Health > 0 then
					local distance = (root.Position - myPos).Magnitude
					if distance < closestDistance then
						closestDistance = distance
						closestPlayer = otherPlayer
					end
				end
			end
		end
	end

	return closestPlayer
end

-- CキーでON/OFF
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if input.KeyCode == Enum.KeyCode.C then
		enabled = not enabled
		if enabled then
			target = getClosestPlayer()
		else
			target = nil
		end
	end
end)

-- カメラを頭へ向ける
RunService:BindToRenderStep(
	"HeadLockOn",
	Enum.RenderPriority.Camera.Value + 1,
	function()
		if not enabled then
			return
		end

		-- 毎フレーム最寄りを更新（動いても追従）
		target = getClosestPlayer()

		if not target then
			return
		end

		local character = target.Character
		if not character then
			target = nil
			return
		end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local head = character:FindFirstChild("Head")

		if not humanoid or humanoid.Health <= 0 or not head then
			target = nil
			return
		end

		local currentCFrame = camera.CFrame
		local targetCFrame = CFrame.lookAt(
			currentCFrame.Position,
			head.Position
		)

		camera.CFrame = currentCFrame:Lerp(
			targetCFrame,
			smoothness
		)
	end
)





-- FTAP Pallet Assist v2
-- Toggle: V
-- Unload: P (completely removes the script)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

------------------------
-- SETTINGS
------------------------
local maxStickDistance = 6
local checkInterval = 0.03
------------------------

local enabled = false
local connection = nil
local inputConn = nil
local charConn = nil
local align = nil
local lastCheck = 0
local unloaded = false

local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function clearAssist()
    if align then
        pcall(function() align:Destroy() end)
        align = nil
    end
end

local function isPalletLike(part)
    if not part or not part:IsA("BasePart") or part.Anchored then return false end
    local name = part.Name:lower()
    if name:find("pallet") or name:find("board") or name:find("platform") or name:find("wood") or name:find("plank") then
        return true
    end
    local size = part.Size
    return size.Y < 4 and (size.X > 3 or size.Z > 3)
end

local function findPlatformBelow(root)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    local result = workspace:Raycast(root.Position, Vector3.new(0, -maxStickDistance, 0), params)
    if result and isPalletLike(result.Instance) then
        return result.Instance, result.Position
    end
    return nil, nil
end

local function createAlign(root, platform)
    clearAssist()
    local att0 = Instance.new("Attachment")
    att0.Parent = root
    local att1 = Instance.new("Attachment")
    att1.Parent = platform

    local a = Instance.new("AlignPosition")
    a.Attachment0 = att0
    a.Attachment1 = att1
    a.RigidityEnabled = false
    a.MaxForce = 3500
    a.MaxVelocity = 40
    a.Responsiveness = 25
    a.ApplyAtCenterOfMass = true
    a.Parent = root
    align = a

    -- keep a small offset so you stand on top
    att1.Position = Vector3.new(0, platform.Size.Y * 0.5 + 2.5, 0)
end

local function mainLoop()
    if unloaded then return end
    if not enabled then
        clearAssist()
        return
    end

    local now = tick()
    if now - lastCheck < checkInterval then return end
    lastCheck = now

    local root = getRoot()
    if not root then
        clearAssist()
        return
    end

    local platform = findPlatformBelow(root)
    if platform then
        if not align or align.Parent ~= root then
            createAlign(root, platform)
        end
    else
        clearAssist()
    end
end

local function unload()
    if unloaded then return end
    unloaded = true
    enabled = false
    clearAssist()
    if connection then connection:Disconnect() end
    if inputConn then inputConn:Disconnect() end
    if charConn then charConn:Disconnect() end
    print("[Pallet Assist] Fully unloaded")
end

connection = RunService.Heartbeat:Connect(mainLoop)

inputConn = UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or unloaded then return end
    if input.KeyCode == Enum.KeyCode.V then
        enabled = not enabled
        if not enabled then clearAssist() end
        print(enabled and "[Pallet Assist] ON" or "[Pallet Assist] OFF")
    elseif input.KeyCode == Enum.KeyCode.P then
        unload()
    end
end)

charConn = LocalPlayer.CharacterAdded:Connect(function()
    clearAssist()
end)

print("[FTAP Pallet Assist v2] Loaded")
print("V = toggle | P = full unload")
