-- FTAP Center Screen Auto Grab v8
-- Toggle: Q
-- Skips if YOU are already holding something + ignores already-grabbed players

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

------------------------
-- SETTINGS
------------------------
local maxDistance = 28
local fov = 0.01
local checkInterval = 0.02
------------------------

local enabled = false
local isHolding = false
local lastCheck = 0

local function press()
    pcall(function() if mouse1press then mouse1press() end end)
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        local vp = Camera.ViewportSize
        vim:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, true, game, 1)
    end)
end

local function release()
    pcall(function() if mouse1release then mouse1release() end end)
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        local vp = Camera.ViewportSize
        vim:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, false, game, 1)
    end)
end

local function isCentered(pos)
    local screen, onScreen = Camera:WorldToViewportPoint(pos)
    if not onScreen or screen.Z <= 0 then return false end
    local size = Camera.ViewportSize
    local dx = (screen.X - size.X * 0.5) / size.X
    local dy = (screen.Y - size.Y * 0.5) / size.Y
    return (dx*dx + dy*dy) <= (fov*fov)
end

-- true if YOU currently have something grabbed
local function isLocalPlayerHolding()
    local grabParts = workspace:FindFirstChild("GrabParts")
    if not grabParts then return false end
    local grabPart = grabParts:FindFirstChild("GrabPart")
    if not grabPart then return false end
    local weld = grabPart:FindFirstChild("WeldConstraint")
    if not weld or not weld.Part1 then return false end
    -- if GrabParts exists and has a valid weld, someone (including you) is holding
    -- we treat any active GrabParts as "already holding"
    return true
end

-- true if the target player is already being held by someone
local function isAlreadyGrabbed(character)
    local grabParts = workspace:FindFirstChild("GrabParts")
    if not grabParts then return false end
    local grabPart = grabParts:FindFirstChild("GrabPart")
    if not grabPart then return false end
    local weld = grabPart:FindFirstChild("WeldConstraint")
    if not weld or not weld.Part1 then return false end
    return weld.Part1:IsDescendantOf(character)
end

local function isHeldByValue(character)
    local player = Players:GetPlayerFromCharacter(character)
    if player and player:FindFirstChild("IsHeld") and player.IsHeld.Value then
        return true
    end
    return false
end

local function getBodyParts(character)
    local parts = {}
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") then
            table.insert(parts, part)
        end
    end
    return parts
end

RunService.Heartbeat:Connect(function()
    if not enabled then
        if isHolding then
            release()
            isHolding = false
        end
        return
    end

    -- if you are already holding something, do nothing
    if isLocalPlayerHolding() then
        if isHolding then
            -- keep the hold state, but don't start a new grab
            return
        end
        return
    end

    local now = tick()
    if now - lastCheck < checkInterval then return end
    lastCheck = now

    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local found = false

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local otherRoot = plr.Character:FindFirstChild("HumanoidRootPart")
            if otherRoot then
                local dist = (root.Position - otherRoot.Position).Magnitude
                if dist <= maxDistance then
                    if not isAlreadyGrabbed(plr.Character) and not isHeldByValue(plr.Character) then
                        for _, part in ipairs(getBodyParts(plr.Character)) do
                            if isCentered(part.Position) then
                                found = true
                                break
                            end
                        end
                    end
                end
            end
        end
        if found then break end
    end

    if found then
        if not isHolding then
            press()
            isHolding = true
        end
    else
        if isHolding then
            release()
            isHolding = false
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.Q then
        enabled = not enabled
        if not enabled and isHolding then
            release()
            isHolding = false
        end
        print(enabled and "[AutoGrab] ON" or "[AutoGrab] OFF")
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    if isHolding then
        release()
        isHolding = false
    end
end)

print("[FTAP AutoGrab v8] Loaded - Press Q")
print("Does nothing while you are already holding something")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local enabled = false
local target = nil

-- 数値を大きくすると速く追従
local smoothness = 0.23

-- 画面中央に一番近いプレイヤーを探す
local function getClosestPlayerToCenter()
	local closestPlayer = nil
	local closestDistance = math.huge

	local viewportSize = camera.ViewportSize
	local center = Vector2.new(
		viewportSize.X / 2,
		viewportSize.Y / 2
	)

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player then
			local character = otherPlayer.Character

			if character then
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				local head = character:FindFirstChild("Head")

				if humanoid and head and humanoid.Health > 0 then
					local screenPos, visible =
						camera:WorldToViewportPoint(head.Position)

					if visible and screenPos.Z > 0 then
						local pos = Vector2.new(
							screenPos.X,
							screenPos.Y
						)

						local distance = (pos - center).Magnitude

						if distance < closestDistance then
							closestDistance = distance
							closestPlayer = otherPlayer
						end
					end
				end
			end
		end
	end

	return closestPlayer
end

-- CキーでON/OFF
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if input.KeyCode == Enum.KeyCode.C then
		enabled = not enabled

		if enabled then
			target = getClosestPlayerToCenter()
		else
			target = nil
		end
	end
end)

-- カメラを頭へ向ける
RunService:BindToRenderStep(
	"HeadLockOn",
	Enum.RenderPriority.Camera.Value + 1,
	function()
		if not enabled or not target then
			return
		end

		local character = target.Character

		if not character then
			target = nil
			return
		end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local head = character:FindFirstChild("Head")

		if not humanoid or humanoid.Health <= 0 or not head then
			target = nil
			return
		end

		local currentCFrame = camera.CFrame

		local targetCFrame = CFrame.lookAt(
			currentCFrame.Position,
			head.Position
		)

		camera.CFrame = currentCFrame:Lerp(
			targetCFrame,
			smoothness
		)
	end
)
-- FTAP Pallet Assist v2
-- Toggle: V
-- Unload: P (completely removes the script)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

------------------------
-- SETTINGS
------------------------
local maxStickDistance = 6
local checkInterval = 0.03
------------------------

local enabled = false
local connection = nil
local inputConn = nil
local charConn = nil
local align = nil
local lastCheck = 0
local unloaded = false

local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function clearAssist()
    if align then
        pcall(function() align:Destroy() end)
        align = nil
    end
end

local function isPalletLike(part)
    if not part or not part:IsA("BasePart") or part.Anchored then return false end
    local name = part.Name:lower()
    if name:find("pallet") or name:find("board") or name:find("platform") or name:find("wood") or name:find("plank") then
        return true
    end
    local size = part.Size
    return size.Y < 4 and (size.X > 3 or size.Z > 3)
end

local function findPlatformBelow(root)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    local result = workspace:Raycast(root.Position, Vector3.new(0, -maxStickDistance, 0), params)
    if result and isPalletLike(result.Instance) then
        return result.Instance, result.Position
    end
    return nil, nil
end

local function createAlign(root, platform)
    clearAssist()
    local att0 = Instance.new("Attachment")
    att0.Parent = root
    local att1 = Instance.new("Attachment")
    att1.Parent = platform

    local a = Instance.new("AlignPosition")
    a.Attachment0 = att0
    a.Attachment1 = att1
    a.RigidityEnabled = false
    a.MaxForce = 25000
    a.MaxVelocity = 40
    a.Responsiveness = 25
    a.ApplyAtCenterOfMass = true
    a.Parent = root
    align = a

    -- keep a small offset so you stand on top
    att1.Position = Vector3.new(0, platform.Size.Y * 0.5 + 2.5, 0)
end

local function mainLoop()
    if unloaded then return end
    if not enabled then
        clearAssist()
        return
    end

    local now = tick()
    if now - lastCheck < checkInterval then return end
    lastCheck = now

    local root = getRoot()
    if not root then
        clearAssist()
        return
    end

    local platform = findPlatformBelow(root)
    if platform then
        if not align or align.Parent ~= root then
            createAlign(root, platform)
        end
    else
        clearAssist()
    end
end

local function unload()
    if unloaded then return end
    unloaded = true
    enabled = false
    clearAssist()
    if connection then connection:Disconnect() end
    if inputConn then inputConn:Disconnect() end
    if charConn then charConn:Disconnect() end
    print("[Pallet Assist] Fully unloaded")
end

connection = RunService.Heartbeat:Connect(mainLoop)

inputConn = UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or unloaded then return end
    if input.KeyCode == Enum.KeyCode.V then
        enabled = not enabled
        if not enabled then clearAssist() end
        print(enabled and "[Pallet Assist] ON" or "[Pallet Assist] OFF")
    elseif input.KeyCode == Enum.KeyCode.P then
        unload()
    end
end)

charConn = LocalPlayer.CharacterAdded:Connect(function()
    clearAssist()
end)

print("[FTAP Pallet Assist v2] Loaded")
print("V = toggle | P = full unload")
