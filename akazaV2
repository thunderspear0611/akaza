local Players2 = game:GetService("Players")
local RunService2 = game:GetService("RunService")
local UserInputService2 = game:GetService("UserInputService")

local player = Players2.LocalPlayer
local camera = workspace.CurrentCamera

local aimEnabled = false
local aimTarget = nil
local aimSmoothness = 0.15

local function getClosestPlayer()
    local myCharacter = player.Character
    if not myCharacter then return nil end

    local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
        or myCharacter:FindFirstChild("Torso")
        or myCharacter:FindFirstChild("UpperTorso")
    if not myRoot then return nil end

    local myPos = myRoot.Position

    local closestPlayer = nil
    local closestDistance = math.huge

    for _, otherPlayer in ipairs(Players2:GetPlayers()) do
        if otherPlayer ~= player then
            local character = otherPlayer.Character
            if character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                local head = character:FindFirstChild("Head")
                local root = character:FindFirstChild("HumanoidRootPart")
                    or character:FindFirstChild("Torso")
                    or character:FindFirstChild("UpperTorso")

                if humanoid and head and root and humanoid.Health > 0 then
                    local distance = (root.Position - myPos).Magnitude
                    if distance < closestDistance then
                        closestDistance = distance
                        closestPlayer = otherPlayer
                    end
                end
            end
        end
    end

    return closestPlayer
end

UserInputService2.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.C then
        aimEnabled = not aimEnabled
        if aimEnabled then
            aimTarget = getClosestPlayer()
        else
            aimTarget = nil
        end
    end
end)

RunService2:BindToRenderStep(
    "HeadLockOn",
    Enum.RenderPriority.Camera.Value + 1,
    function()
        if not aimEnabled then return end

        aimTarget = getClosestPlayer()
        if not aimTarget then return end

        local character = aimTarget.Character
        if not character then
            aimTarget = nil
            return
        end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local head = character:FindFirstChild("Head")

        if not humanoid or humanoid.Health <= 0 or not head then
            aimTarget = nil
            return
        end

        local currentCFrame = camera.CFrame
        local targetCFrame = CFrame.lookAt(currentCFrame.Position, head.Position)
        camera.CFrame = currentCFrame:Lerp(targetCFrame, aimSmoothness)
    end
)






local Players3 = game:GetService("Players")
local RunService3 = game:GetService("RunService")
local UserInputService3 = game:GetService("UserInputService")
local LocalPlayer3 = Players3.LocalPlayer

local maxStickDistance = 6
local checkInterval = 0.03

local palletEnabled = false
local palletConnection = nil
local palletInputConn = nil
local palletCharConn = nil
local palletAlign = nil
local palletLastCheck = 0
local palletUnloaded = false

local function getRoot()
    local char = LocalPlayer3.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function clearAssist()
    if palletAlign then
        pcall(function() palletAlign:Destroy() end)
        palletAlign = nil
    end
end

local function isPalletLike(part)
    if not part or not part:IsA("BasePart") or part.Anchored then return false end
    local name = part.Name:lower()
    if name:find("pallet") or name:find("board") or name:find("platform") or name:find("wood") or name:find("plank") then
        return true
    end
    local size = part.Size
    return size.Y < 4 and (size.X > 3 or size.Z > 3)
end

local function findPlatformBelow(root)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer3.Character}
    local result = workspace:Raycast(root.Position, Vector3.new(0, -maxStickDistance, 0), params)
    if result and isPalletLike(result.Instance) then
        return result.Instance, result.Position
    end
    return nil, nil
end

local function createAlign(root, platform)
    clearAssist()
    local att0 = Instance.new("Attachment")
    att0.Parent = root
    local att1 = Instance.new("Attachment")
    att1.Parent = platform

    local a = Instance.new("AlignPosition")
    a.Attachment0 = att0
    a.Attachment1 = att1
    a.RigidityEnabled = false
    a.MaxForce = 3000
    a.MaxVelocity = 40
    a.Responsiveness = 25
    a.ApplyAtCenterOfMass = true
    a.Parent = root
    palletAlign = a
    att1.Position = Vector3.new(0, platform.Size.Y * 0.5 + 2.5, 0)
end

local function palletMainLoop()
    if palletUnloaded then return end
    if not palletEnabled then
        clearAssist()
        return
    end

    local now = tick()
    if now - palletLastCheck < checkInterval then return end
    palletLastCheck = now

    local root = getRoot()
    if not root then
        clearAssist()
        return
    end

    local platform = findPlatformBelow(root)
    if platform then
        if not palletAlign or palletAlign.Parent ~= root then
            createAlign(root, platform)
        end
    else
        clearAssist()
    end
end

local function palletUnload()
    if palletUnloaded then return end
    palletUnloaded = true
    palletEnabled = false
    clearAssist()
    if palletConnection then palletConnection:Disconnect() end
    if palletInputConn then palletInputConn:Disconnect() end
    if palletCharConn then palletCharConn:Disconnect() end
    print("[Pallet Assist] Fully unloaded")
end

palletConnection = RunService3.Heartbeat:Connect(palletMainLoop)

palletInputConn = UserInputService3.InputBegan:Connect(function(input, gpe)
    if gpe or palletUnloaded then return end
    if input.KeyCode == Enum.KeyCode.V then
        palletEnabled = not palletEnabled
        if not palletEnabled then clearAssist() end
        print(palletEnabled and "[Pallet Assist] ON" or "[Pallet Assist] OFF")
    elseif input.KeyCode == Enum.KeyCode.P then
        palletUnload()
    end
end)

palletCharConn = LocalPlayer3.CharacterAdded:Connect(function()
    clearAssist()
end)

print("[FTAP Pallet Assist v2] Loaded")
print("V = toggle | P = full unload")
